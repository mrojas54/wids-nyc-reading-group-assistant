{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "turbopuffer": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env.turbopuffer.local scripts/turbopuffer.mts",
    "paperpal:search": "node --experimental-strip-types --conditions=react-server --env-file-if-exists=.env.paperpal.local scripts/paperpal-search.mts"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "postcss": "$postcss",
    "@vercel/cli-config": {
      "zod": "$zod"
    },
    "sharp": "^0.35.0",
    "brace-expansion": "^5.0.8",
    "minimatch@^3": {
      "brace-expansion": "^1.1.21"
    },
    "chevrotain": {
      "lodash-es": "4.18.1"
    },
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    }
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "@xenova/transformers": "^2.17.2",
    "mermaid": "^12.2.0",
    "next": "16.4.2",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "msw": "^3.0.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
