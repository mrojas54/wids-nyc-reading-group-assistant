# Copy to .env.turbopuffer.local (gitignored). Keep the key server-side.
# Create a key at https://turbopuffer.com/dashboard; never paste it into chat.
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=gcp-us-central1
# Use a developer-specific prefix. The CLI requires paperpal-local at the start.
TURBOPUFFER_NAMESPACE_PREFIX=paperpal-local-yourname
# Initial evaluation candidate, not a validated model choice for paper 41.
TURBOPUFFER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-8b
TURBOPUFFER_EMBEDDING_DIMENSIONS=1024
