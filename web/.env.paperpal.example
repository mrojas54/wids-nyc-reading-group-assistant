# Copy to .env.paperpal.local; this CLI does not load production .env.local.
PAPERPAL_RETRIEVAL_BACKEND=supabase
PAPERPAL_SUPABASE_URL=http://127.0.0.1:54321
# Use a local service-role key for ingestion. Never use NEXT_PUBLIC_* for it.
PAPERPAL_SUPABASE_KEY=
# For RLS-respecting search, use the publishable/anon key above and a member JWT here.
PAPERPAL_SUPABASE_ACCESS_TOKEN=
PAPERPAL_MODEL_CACHE=.paperpal-local/models
# Turbopuffer is optional. Its separate .env.turbopuffer.example remains available.
